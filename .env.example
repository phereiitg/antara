# Copy to .env (never commit .env). Leave a value empty to disable that integration.

# Gemini: used for extraction, verification, vision checks and (optionally) speech-to-text.
GEMINI_API_KEY=
# Model for extraction/verification/vision. Check which models your key can use.
GEMINI_MODEL=gemini-3.8-flash

# Cline agent (the reasoning step that proposes actions). Provider/model IDs from Cline's catalog.
CLINE_PROVIDER_ID=gemini
CLINE_MODEL_ID=gemini-3.8-flash
# Falls back to GEMINI_API_KEY when empty and CLINE_PROVIDER_ID=gemini.
CLINE_PROVIDER_API_KEY=

# Speech-to-text provider: gemini | gnani | fixture
STT_PROVIDER=gemini
# Gnani endpoint/credentials are account-specific (see blueprint section 13); the client is a stub until filled in.
GNANI_API_KEY=
GNANI_ENDPOINT=

# Optional: path to a system ffmpeg. Defaults to the bundled ffmpeg-static binary.
FFMPEG_PATH=

# Where cases, extracted audio and evidence frames are stored.
ANTARA_DATA_DIR=data
