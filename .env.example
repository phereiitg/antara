# Copy to .env in the repository root (never commit .env). Shared by the Python backend
# (backend/) and the TypeScript CLI (src/). Leave a value empty to disable that integration.
# Never put real keys in this file.

ENVIRONMENT=development

# --- Gemini: vision, document understanding, structured extraction --------------------
GEMINI_API_KEY=
# Stable model with text + image input (verified against ai.google.dev/gemini-api/docs/models).
# Empty = gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# --- Gnani speech-to-text (REST POST https://api.vachana.ai/stt/v3) ---------------------
# One API key from the Gnani API dashboard, sent as the X-API-Key-ID header.
# No organisation id, user id or certificates are needed for this API.
GNANI_API_KEY=
# hi-IN, en-IN, bn-IN, gu-IN, kn-IN, ml-IN, mr-IN, pa-IN, ta-IN, te-IN
GNANI_LANGUAGE=hi-IN

# Providers. STT_PROVIDER: gnani | gemini | fixture. VISION_PROVIDER: gemini.
# NOTE: the TypeScript CLI's Gnani client is still a stub; for `npm run antara -- run`
# set STT_PROVIDER=gemini. The Python backend implements Gnani.
STT_PROVIDER=gnani
VISION_PROVIDER=gemini

# --- Cline SDK (TypeScript) ------------------------------------------------------------
# Future TypeScript Cline bridge service that the Python backend will call (Phase 3+).
CLINE_BRIDGE_URL=http://127.0.0.1:4317
# Used today by the TypeScript CLI agent. Provider/model IDs from Cline's catalog.
CLINE_PROVIDER_ID=gemini
CLINE_MODEL_ID=gemini-3.8-flash
# Falls back to GEMINI_API_KEY when empty and CLINE_PROVIDER_ID=gemini.
CLINE_PROVIDER_API_KEY=

# --- Storage ---------------------------------------------------------------------------
# Cases, extracted audio and evidence frames. Relative paths: repo root (Python) / cwd (TS).
ANTARA_DATA_DIR=./data
# SQLite for now; PostgreSQL later. Not used until Phase 2.
DATABASE_URL=sqlite:///./data/antara.db

# --- Optional tuning (defaults shown) --------------------------------------------------
# LOG_LEVEL=INFO
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_ATTEMPTS=3
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_TIMEOUT_SECONDS=60
# GNANI_MAX_ATTEMPTS=3

# Optional (TypeScript CLI): path to a system ffmpeg. Defaults to the bundled ffmpeg-static.
FFMPEG_PATH=
